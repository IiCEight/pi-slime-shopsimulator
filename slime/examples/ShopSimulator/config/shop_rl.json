{
  "datasets": {
    "rl": {
      "path": "examples/ShopSimulator/data/tasks_v2/rl_500.jsonl"
    }
  },
  "training": {
    "num_epoch": 1,
    "n_samples_per_prompt": 4,
    "num_steps_per_rollout": 1,
    "micro_batch_size": 1,
    "learning_rate": 1e-06,
    "lr_decay_style": "constant",
    "kl_loss_coefficient": 0.001,
    "kl_loss_type": "low_var_kl",
    "entropy_coefficient": 0.0,
    "eps_clip": 0.2,
    "eps_clip_high": 0.28,
    "gradient_clip": 1.0,
    "seed": 1234,
    "rollout_batch_size": 5,
    "global_batch_size": 20
  },
  "rollout": {
    "max_context_len": 16384,
    "max_response_len": 2048,
    "max_model_turns": 40,
    "wall_clock_timeout_seconds": 600,
    "context_keep_shop_act_results": 3,
    "temperature": 1.0,
    "top_p": 1.0,
    "top_k": -1,
    "seed": 42,
    "custom_generate_function_path": "examples.ShopSimulator.generate.generate",
    "reward_post_process_path": "examples.ShopSimulator.generate.normalize_candidate_group_rewards",
    "sample_filter_path": "examples.ShopSimulator.generate.validate_complete_groups"
  },
  "concurrency": {
    "shop_env_capacity": 20,
    "rollout_num_engines": 1
  }
}
